
name: Build Beryl M762

on:
  push:
    paths:
      - '*.zip'
      - '.github/workflows/build.yml'
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract project archive
        shell: bash
        run: |
          set -euo pipefail

          ARCHIVE="$(find . -maxdepth 1 -type f -iname 'BerylM762-Forge-1.12.2.zip' -print -quit)"

          if [ -z "$ARCHIVE" ]; then
            echo "Project ZIP not found!"
            exit 1
          fi

          mkdir -p extracted
          unzip -q "$ARCHIVE" -d extracted

          BUILD_FILE="$(find extracted -type f -name build.gradle -print -quit)"

          if [ -z "$BUILD_FILE" ]; then
            echo "build.gradle not found!"
            exit 1
          fi

          PROJECT_DIR="$(dirname "$BUILD_FILE")"
          cp -a "$PROJECT_DIR"/. .

      - name: Set up Java 8
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '8'

      - name: Install Gradle 4.9
        run: |
          wget -q https://services.gradle.org/distributions/gradle-4.9-bin.zip
          unzip -q gradle-4.9-bin.zip -d "$HOME/gradle"
          echo "$HOME/gradle/gradle-4.9/bin" >> "$GITHUB_PATH"

      - name: Build mod
        run: gradle build --no-daemon

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: BerylM762-Forge-1.12.2
          path: build/libs/*.jar
          if-no-files-found: error
